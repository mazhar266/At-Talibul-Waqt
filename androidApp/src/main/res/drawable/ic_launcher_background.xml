<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the teal gradient and soft glow from icons/at_talibul_waqt_icon.svg.
  The viewport is the SVG's 1024 square mapped onto the 72dp visible area of the 108dp canvas
  (offset 170.67, scale 2/3), so the visible part of the gradient matches the exported PNGs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="170.667"
                android:startY="170.667"
                android:endX="853.333"
                android:endY="853.333">
                <item android:offset="0" android:color="#FF125F53" />
                <item android:offset="0.52" android:color="#FF094A43" />
                <item android:offset="1" android:color="#FF062D31" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- radial glow behind the dial: SVG circle (512,420) r=395 -->
    <path android:pathData="M248.667,450.667a263.333,263.333 0 1,0 526.667,0a263.333,263.333 0 1,0 -526.667,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="450.667"
                android:gradientRadius="263.333">
                <item android:offset="0" android:color="#6E3E9280" />
                <item android:offset="1" android:color="#003E9280" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
